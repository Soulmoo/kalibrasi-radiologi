# Connection string Postgres — dipakai untuk lokal maupun produksi.
# Ambil dari Neon atau Vercel Postgres (lihat PANDUAN_DEPLOY_VERCEL.md).
DATABASE_URL="postgresql://user:password@host.neon.tech/nama_db?sslmode=require"

# Rahasia untuk menandatangani sesi login. Buat dengan: npx auth secret
AUTH_SECRET="isi-dengan-string-acak-panjang"

# Diperlukan Auth.js saat berjalan di belakang proxy seperti Vercel.
AUTH_TRUST_HOST=true

# Email akun MASTER (dipisah koma) — peran tertinggi. Master mengatur peran
# akun lain (Fismed <-> Admin) dan menghapus akun. Perannya hanya bisa diubah
# dari sini, tidak dari dalam aplikasi.
MASTER_EMAILS="email.master@contoh.com"

# Masuk dengan Google — OPSIONAL. Kalau dua baris ini dikosongkan, tombol
# "Masuk dengan Google" tidak ditampilkan dan aplikasi tetap jalan normal
# dengan email + kata sandi.
#
# Ambil dari Google Cloud Console → APIs & Services → Credentials →
# Create Credentials → OAuth client ID → Web application.
# Authorized redirect URI yang harus didaftarkan di sana:
#   http://localhost:3000/api/auth/callback/google      (untuk lokal)
#   https://<domain-anda>/api/auth/callback/google      (untuk produksi)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
